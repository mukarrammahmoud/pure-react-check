{
  "name": "pure-react-check",
  "version": "1.3.2",
  "description": "Static analysis CLI for React component purity and compiler readiness",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./bailout": {
      "types": "./dist/bailout/analyser.d.ts",
      "import": "./dist/bailout/analyser.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "import": "./dist/compiler/index.js"
    }
  },
  "bin": {
    "pure-react-check": "./bin/pure-react-check.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup src/index.ts src/api.ts src/compiler/index.ts src/bailout/analyser.ts --format esm --clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm typecheck && node --import tsx/esm --test tests/bailout.test.ts tests/compiler-compat.test.ts tests/ground-truth.test.ts",
    "test:compiler-compat": "node --import tsx/esm --test tests/compiler-compat.test.ts",
    "test:ground-truth": "node --import tsx/esm --test tests/ground-truth.test.ts",
    "prepublishOnly": "pnpm build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mukarrammahmoud/pure-react-check.git"
  },
  "bugs": {
    "url": "https://github.com/mukarrammahmoud/pure-react-check/issues"
  },
  "homepage": "https://github.com/mukarrammahmoud/pure-react-check#readme",
  "keywords": [
    "react",
    "react-compiler",
    "static-analysis",
    "ast",
    "cli",
    "purity",
    "compiler-readiness",
    "sarif",
    "eslint"
  ],
  "author": "mukarram mahmoud",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@babel/types": "^8.0.4",
    "fast-glob": "^3.3.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}